# === Bot ===
BOT_NAME=Suhrob HOUSE Bot Platform
USE_PREMIUM_EMOJI=false

# === Database ===
# Local docker-compose creates this database user and reads DB_PASSWORD.
# Keep the password in DATABASE_URL in sync with DB_PASSWORD.
DB_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://suhrob:changeme@db:5432/suhrob_bot

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Developer (only hardcoded role) ===
DEVELOPER_TELEGRAM_ID=your_telegram_id
DEVELOPER_NAME=Your Name

# Pre-configured director and agents (auto-registered on startup)
# Uncomment and fill in real Telegram user IDs (numbers only, no spaces)
# DIRECTOR_TELEGRAM_ID=6093721405
# AGENT_1_TELEGRAM_ID=6204594367
# AGENT_2_TELEGRAM_ID=123456791
# AGENT_3_TELEGRAM_ID=123456792

# === OpenRouter AI ===
# Get your key at https://openrouter.ai/keys
OPENROUTER_MODEL=google/gemini-2.5-flash
AI_DAILY_LIMIT_PER_USER=50

# === Payment ===
MONTHLY_PRICE_USD=49
CURRENCY_RATE_UZS_PER_USD=12600
PAYMENT_CLICK_CARD=9869100126034816
PAYMENT_CLICK_HOLDER=Suhrob HOUSE
PAYMENT_CLICK_QR_FILE_ID=
PAYMENT_HUMO_CARD=9869100126034816
PAYMENT_HUMO_HOLDER=Suhrob HOUSE
PAYMENT_HUMO_QR_FILE_ID=
PAYMENT_UZCARD_CARD=9869100126034816
PAYMENT_UZCARD_HOLDER=Suhrob HOUSE
PAYMENT_UZCARD_QR_FILE_ID=
PAYMENT_CARD_QR_FILE_ID=
PAYMENT_CRYPTO_ADDRESS=TUr3m7sAWpiysQs5S1jQkbxcvJARqAD8Rs
PAYMENT_CRYPTO_NETWORK=USDT TRC-20

# === Storage ===
MEDIA_PATH=/var/suhrob_bot/media

# === Logging ===
LOG_LEVEL=INFO

# === Timezone ===
TIMEZONE=Asia/Tashkent

# === Premium Emoji IDs (optional) ===
PREMIUM_EMOJI_HOUSE=
PREMIUM_EMOJI_MONEY=
PREMIUM_EMOJI_LOCATION=
PREMIUM_EMOJI_FIRE=
PREMIUM_EMOJI_STAR=
