# === Bot ===
BOT_NAME=Suhrob HOUSE Bot Platform
USE_PREMIUM_EMOJI=false

# === Database ===
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/suhrob_bot

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Developer (only hardcoded role) ===
DEVELOPER_TELEGRAM_ID=your_telegram_id
DEVELOPER_NAME=Your Name

# === OpenRouter AI ===
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_API_KEY
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AI_DAILY_LIMIT_PER_USER=50

# === Storage ===
MEDIA_PATH=/var/suhrob_bot/media

# === Logging ===
LOG_LEVEL=INFO

# === Timezone ===
TIMEZONE=Asia/Tashkent

# === Premium Emoji IDs (optional) ===
PREMIUM_EMOJI_HOUSE=
PREMIUM_EMOJI_MONEY=
PREMIUM_EMOJI_LOCATION=
PREMIUM_EMOJI_FIRE=
PREMIUM_EMOJI_STAR=
